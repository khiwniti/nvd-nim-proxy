# Required: get one at https://build.nvidia.com (free, NVIDIA Developer Program)
NVIDIA_API_KEY=nvapi-your-key-here

# Optional
PROXY_CONFIG=config.yaml
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
DEFAULT_NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
PROXY_HOST=127.0.0.1
PROXY_PORT=8787
# PROXY_API_KEY=  # set to require x-api-key from clients (optional)
LOG_LEVEL=info

# 0.3.0 tuning knobs (all optional; defaults shown).
# Hard wall cap on one streaming /v1/messages exchange. When the budget elapses
# the proxy emits a clean stop_reason=max_tokens + message_stop instead of a
# TCP RST that Claude Code interprets as "force quit".
# PROXY_STREAM_BUDGET_SECONDS=600.0

# Lifespan pre-flight probe concurrency. Sequential probes could stall boot for
# ~200 s on a slow day; this caps in-flight probes during startup.
# PROXY_PREFLIGHT_CONCURRENCY=4

# Per-probe per-phase timeout (connect/read/write/pool). A slow TCP connect
# can't eat the entire read budget any more.
# PROXY_PREFLIGHT_TIMEOUT_S=6.0

# Hard cap on the entire pre-flight fanout. Beyond this the proxy starts
# without blocked-model detection (existing routes still report account denial
# accurately on the first request to each affected target).
# PROXY_PREFLIGHT_TOTAL_S=8.0
